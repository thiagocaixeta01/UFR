------ Criação do Superuser (AdmUniversidade) ------
create user admuniversidade with superuser encrypted password 'abc';

------ Criação do Banco (Universidade) ------
create database universidade with owner = admuniversidade;

==========================================================================================================

------ Criação das Tabelas ------

    ------ Instituto ------
create table instituto(
    codigoinstituto int constraint instituto_pk primary key,
    nomeinstituto   varchar(40) constraint nome_instituto_nn not null);

    ------ Curso ------
create table curso(
    codigocurso     int constraint curso_pk primary key,
    codigoinstituto int,
    nomecurso       varchar(40) constraint nome_curso_nn not null,
    constraint codigo_instituto_curso_fk foreign key (codigoinstituto) references instituto (codigoinstituto));

    ------ Disciplinas ------
create table disciplinas(
    codigodisciplina    int constraint disciplina_pk primary key,
    codigocurso         int,
    nomedisciplina      varchar(30) constraint nome_disciplina_nn not null,
    cargahoraria        numeric(2),
    constraint codigo_curso_disciplina_fk foreign key (codigocurso) references curso (codigocurso));

    ------ Turma ------
create table turma(
    nrlancamento        int constraint turma_pk primary key,
    matricula           int constraint matricula_nn not null,
    codigodisciplina    int,
    faltas              numeric(3),
    nota1   numeric(4,2), nota2   numeric(4,2),
    nota3   numeric(4,2), nota4   numeric(4,2));

