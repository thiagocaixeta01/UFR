------ Criação do Superuser (adminlocadora) ------
create user adminlocadora with superuser encrypted password 'abc';

------ Criação do Banco (Locadora) ------
create database locadora with owner = adminlocadora;

==========================================================================================================

------ Criação das Tabelas ------
    
    ------ Veículos ------
create table veiculos(
    codigoveiculo   int constraint veiculo_pk primary key,
    descricao       varchar(40) constraint descricao_nn not null);

    ------ Clientes ------
create table clientes(
    codigocliente   int constraint cliente_pk primary key,
    nomecliente     varchar(40) constraint nome_cliente_nn not null);

    ------ Funcionário ------
create table funcionario(
    codigofuncionario   int constraint funcionario_pk primary key,
    nomefuncionario     varchar(30) constraint nome_funcionario_nn not null);

    ------ Locações ------
create table locacoes(
    nrlancamento        int constraint locacao_pk primary key,
    datasaida           date,
    dataretorno         date,
    codigocliente       int,
    codigofuncionario   int,
    constraint codigo_cliente_fk foreign key (codigocliente) references clientes (codigocliente),    
    constraint codigo_funcionario_fk foreign key (codigofuncionario) references funcionario (codigofuncionario));

==========================================================================================================

------ Criação dos Papéis (ROLES) e Usuários ------

    ------ Supervisores ------
create user supervisores with encrypted password 'abc';
grant connect on database locadora to supervisores;
grant select, insert, update on all tables in schema public to supervisores;

