------ Criação da Área de Tabalho e Banco de Dados ------
create tablespace tbl_controlevendas location '/home/thiago/revisao';
set default_tablespace=tbl_controlevendas;

create database vendasveiculosdb;

    ------ Usuários para Administras ------
create user adminvendas with superuser encrypted password 'abc';

==========================================================================================================

------ Criação das Tabelas ------

    ------ Tabela Veículos ------
create table veiculos(
    codigoveiculo         numeric(5) constraint veiculo_pk primary key,
    modeloveiculo   varchar(50) constraint modelo_nn not null,
    precovenda      numeric(10,2) constraint preco_nn not null,
    constraint preco_ck check (precovenda > 0));

    ------ Tabela Clientes ------
create table clientes(
    codigocliente   numeric(5) constraint cliente_pk primary key,
    nomecliente     varchar(50) constraint nome_nn not null,
    cpf             varchar(11));

    ------ Tabela Vendas Veículos ------
create table vendasveiculos(
    codigovenda     numeric(5) constraint codigo_venda_pk primary key,
    codigoveiculo   numeric(5),
    codigocliente   numeric(5),
    quantidade      numeric(10) constraint quantidade_venda_nn not null,
    tipopagamento   varchar(1) constraint tipo_pagamento_ck check ((tipopagamento = 'A') or (tipopagamento = 'F')),
    constraint codigo_veiculo_fk foreign key (codigoveiculo) references veiculos (codigoveiculo),
    constraint codigo_cliente_fk foreign key (codigocliente) references clientes (codigocliente));

