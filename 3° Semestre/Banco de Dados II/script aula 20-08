---------------------- Criação de tabelas ----------------------

--- Tabela ALUNOS ---

create table Alunos(
    Matricula numeric(8) constraint aluno_pk primary key,
    NomeAluno varchar(30) constraint nome_nn not null);

create table Cursos(
    CodigoCurso numeric(3) constraint curso_pk primary key,
    NomeCurso   varchar(50) constraint nome_curso_nn not null);

create table Disciplinas (
    CodigoDisciplina    numeric(4) constraint disciplina_pk primary key,
    NomeDisciplina      varchar(40) constraint nome_disciplina_nn not null);

create table Notas(
    NrLancamentos       numeric(5) constraint notas_pk primary key,
    Matricula           numeric(8),
    CodigoDisciplina    numeric(4),
    CodigoCurso         numeric(3),
    Nota1               numeric(4,2), Nota2 numeric(4,2),
    Nota3               numeric(4,2), Nota4 numeric(4,2), 
    constraint nota1_ck check ((nota1 >= 0) and (nota1 <= 10)),
    constraint nota2_ck check ((nota2 >= 0) and (nota2 <= 10)),
    constraint nota3_ck check ((nota3 >= 0) and (nota3 <= 10)),
    constraint nota4_ck check ((nota4 >= 0) and (nota4 <= 10)));

