--- Tabelas Cursos e Alunos ---

create table cursos(
    codigocurso     numeric(3) constraint curso_pk primary key,
    nomecurso       varchar(50) constraint curso_nn not null);

create table alunos(
    matricula   numeric(4) constraint aluno_pk primary key,
    nomealuno   varchar(50) constraint aluno_nn not null,
    codigocurso numeric (3));

--- Chave estrangeira (Fk) ---

alter table alunos add constraint alunos_cursos_fk foreign key(codigocurso) references cursos(codigocurso);

