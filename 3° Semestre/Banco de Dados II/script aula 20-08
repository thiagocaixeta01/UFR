--- Exercício Estados -> Cidades ---

--- Tabela Estado e Cidade ---

create table Estados(
    codigoEstado    serial constraint estado_pk primary key, 
    nomeEstado      varchar(30) constraint estado_nn not null,
    sigla           varchar(2) constraint sigla_nn not null); 

create table Cidades(
    codigoCidade    serial constraint cidade_pk primary key,
    nomeCidade      varchar(40) constraint cidade_nn not null,
    codigoestado    int, 
    constraint cidades_estados_fk foreign key(codigoestado) references Estados (codigoEstado));


