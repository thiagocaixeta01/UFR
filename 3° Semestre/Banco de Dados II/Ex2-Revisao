------ Criação da tablespace e do Bando de Dados ------
create tablespace tbl_controleescolar location '/tmp/Exe2_revisao';
set default_tablespace=tbl_controleescolar;

create database escoladb;

==========================================================================================================

------ Criação do superuser (AdminEcolar) ------
create user adminescolar with superuser encrypted password 'abc';

==========================================================================================================

------ Criação das Tabelas ------

    ------ Tabela Aluno ------
create table aluno(
    codigoaluno     numeric(5) constraint aluno_pk primary key,
    nomealuno       varchar(50) constraint nome_aluno_nn not null,
    datanascimento  date constraint data_nasc_nn not null);

    ------ Tabela Cursos ------
create table cursos(
    codigocurso     numeric(5) constraint curso_pk primary key,
    nomecurso       varchar(50) constraint nome_curso_nn not null,
    valormensalidade    numeric(10,2) constraint valor_nn not null,
    constraint valor_mensalidade_ck check (valormensalidade > 0));
    
    ------ Tabela Matriculas ------
create table matriculas(
    codigomatricula     numeric(5) constraint matricula_pk primary key,
    codigoaluno         numeric(5),
    codigocurso         numeric(5),
    turno               varchar(1),
    constraint turno_ck check ((turno = 'M') or (turno = 'T') or (turno = 'N')),
    desconto            numeric(5,2),
    constraint desconto_ck check (desconto > 0),
    constraint codigo_aluno_fk foreign key (codigoaluno) references aluno (codigoaluno),
    constraint codigo_curso_fk foreign key (codigocurso) references cursos (codigocurso));

